{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>dixneuf19/renovate-presets"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "npm packages loaded from jsDelivr in karaoke templates; their integrity hashes are updated by hand (make sri), CI checks them",
      "managerFilePatterns": ["/^karaoke/karaoke/templates/.+\\.html$/"],
      "matchStrings": [
        "https://cdn\\.jsdelivr\\.net/npm/(?<depName>[a-z0-9][a-z0-9._-]*)@(?<currentValue>\\d+\\.\\d+\\.\\d+)/"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "npm packages run by deno to lint the karaoke JS (make check-format)",
      "managerFilePatterns": ["/^karaoke/Makefile$/", "/^karaoke/eslint\\.config\\.js$/"],
      "matchStrings": [
        "npm:(?<depName>(@[a-z0-9-]+/)?[a-z0-9][a-z0-9._-]*)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "deno in the karaoke CI, kept on the image's version",
      "managerFilePatterns": ["/^\\.github/workflows/karaoke-test\\.yml$/"],
      "matchStrings": ["deno-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "denoland/deno",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "htmx 4 is published under npm's next tag while latest stays on 2.x until 2027: keep proposing 4.x",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["htmx.org"],
      "respectLatest": false
    },
    {
      "description": "The uv builder image carries the Python version in its tag (python3.15-trixie-slim), which docker versioning cannot parse. Version it by that Python and move it with the runtime image",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/astral-sh/uv"],
      "matchCurrentValue": "/^python\\d+\\.\\d+-/",
      "versioning": "regex:^python(?<major>\\d+)\\.(?<minor>\\d+)-(?<compatibility>.+)$",
      "groupName": "python runtime"
    },
    {
      "description": "Same manual review as the python runtime itself (see the preset)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/astral-sh/uv"],
      "matchCurrentValue": "/^python\\d+\\.\\d+-/",
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false
    }
  ]
}
